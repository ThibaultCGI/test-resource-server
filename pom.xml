<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>io.github.tbondetti</groupId>
	<artifactId>test-resource-server</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<description>Projet de simulation d'un Resource Server afin de tester l'application "auth-server" et l'authentification OAuth2</description>

	<url>https://github.com/ThibaultCGI/test-resource-server</url>

	<developers>
		<developer>
			<name>Thibault BONDETTI</name>
			<email>thibault.bondetti@cgi.com</email>
		</developer>
	</developers>
	<modules>
		<module>test-resource-server-core</module>
		<module>test-resource-server-infrastructure</module>
		<module>test-resource-server-boot</module>
		<module>test-resource-server-coverage-report</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>25</java.version>
		<lombok.version>1.18.46</lombok.version>
		<spingdoc.version>3.0.3</spingdoc.version>

		<!-- Pour générer des rapport de couverture de TU pour SONAR -->
		<jacoco.version>0.8.15</jacoco.version>
		<sonar-maven-plugin.version>5.7.0.6970</sonar-maven-plugin.version>
		<sonar.organization>thibaultcgi</sonar.organization>
		<sonar.projectKey>ThibaultCGI_test-resource-server</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.coverage.jacoco.aggregateXmlReportPaths>
			${maven.multiModuleProjectDirectory}/test-resource-server-coverage-report/target/site/jacoco-aggregate/jacoco.xml
		</sonar.coverage.jacoco.aggregateXmlReportPaths>

		<!--
		 On ne teste pas les fichiers de configuration
		 Ni le starter
		 Ni les adapters qui simulent des données random
	 	-->
		<sonar.coverage.exclusions>
			**/TestResourceServerApplication.java,
			**/config/**,
			**/*Configuration.java,
			**/**Adapter.java,
			**/DomainGeneratorUtils.java
		</sonar.coverage.exclusions>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.github.tbondetti</groupId>
				<artifactId>test-resource-server-core</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>io.github.tbondetti</groupId>
				<artifactId>test-resource-server-infrastructure</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>io.github.tbondetti</groupId>
				<artifactId>test-resource-server-boot</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
			</dependency>

			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${spingdoc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<release>${java.version}</release>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.6</version>
				</plugin>

				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
